{
  "experiment": {
    "train_subjects": 100,
    "train_tasks": 20,
    "n_repeats": 1,
    "random_seed": 42,
    "experiment_name": "",
    "output_dir": "outputs/hi_task_emb_new"
  },
  "model": {
    "input_dim": 12,
    "segment_d_model": 96,
    "segment_nhead": 4,
    "segment_num_layers": 3,
    "task_d_model": 192,
    "task_nhead": 4,
    "task_num_layers": 1,
    "attention_dim": 48,
    "dropout": 0.25,
    "use_task_embedding": false,
    "use_task_encoder": true,
    "task_embedding_dim": 8
  },
  "training": {
    "batch_size": 8,
    "learning_rate": 0.00008,
    "weight_decay": 0.0005,
    "warmup_epochs": 5,
    "epochs": 400,
    "patience": 200,
    "grad_clip": 1.0,
    "label_smoothing": 0.03
