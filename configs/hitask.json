{
  "experiment": {
    "train_subjects": 100,
    "train_tasks": 20,
    "n_repeats": 1,
    "random_seed": 42,
    "experiment_name": "",
    "output_dir": "outputs/hi_task_emb_new"
  },
  "sequence": {
    "max_seq_len": 150,
    "max_tasks": 30,
    "max_segments": 30,
    "screen_width": 1920,
    "screen_height": 1080,
    "input_dim": 7
  },
  "model": {
    "segment_d_model": 96,
    "segment_nhead": 4,
    "segment_num_layers": 3,
    "task_d_model": 192,
    "task_nhead": 4,
    "task_num_layers": 2,
    "attention_dim": 48,
    "dropout": 0.25,
    "use_task_embedding": true,
    "task_embedding_mode": "dynamic",
    "task_embedding_dim": 16,
    "segment_encoder_type": "transformer"
  },
  "training": {
    "batch_size": 8,
    "learning_rate": 8e-05,
    "weight_decay": 0.0005,
    "warmup_epochs": 5,
    "epochs": 400,
    "patience": 200,
    "grad_clip": 1.0,
    "label_smoothing": 0.03
  },
  "task": {
    "type": "classification",
    "num_classes": 3,
    "use_class_weights": true
  },
  "device": {
    "device": "cuda",
    "use_multi_gpu": true,
    "use_amp": true,
    "use_gradient_checkpointing": false,
    "num_workers": 8,
    "pin_memory": true
  },
  "output": {
    "save_best": true,
    "save_figures": true,
    "figure_dpi": 150,
    "summary_interval": 10
  }
}