  "output": {
    "save_best": true,
    "save_figures": true,
    "figure_dpi": 150,
    "summary_interval": 10
  },
  "distill": {
    "enable": false,
    "teacher_model_path": "outputs/segment_models/20260203_213116/best_model_fold0.pt",
    "teacher_config_path": "configs/seg.json",
    "temperature": 2.0,
    "alpha": 0.55,
    "aggregation": "mean"
