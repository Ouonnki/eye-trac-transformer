{
  "experiment": {
    "name": "task_level_small_model",
    "output_dir": "outputs/task_level",
    "random_seed": 42,
    "train_subjects": 100,
    "train_tasks": 20,
    "n_repeats": 1
  },
  "sequence": {
    "max_seq_len": 300,
    "max_segments": 25,
    "screen_width": 1920,
    "screen_height": 1080,
    "input_dim": 7
  },
  "model": {
    "segment_d_model": 32,
    "segment_nhead": 2,
    "segment_num_layers": 1,
    "attention_dim": 16,
    "task_embedding_dim": 2,
    "use_task_embedding": true,
    "dropout": 0.0,
    "num_classes": 3,
    "use_gradient_checkpointing": false,
    "segment_encoder_type": "transformer"
  },
  "training": {
    "batch_size": 16,
    "num_workers": 0,
    "epochs": 10,
    "lr": 1e-05,
    "weight_decay": 0.001,
    "grad_clip": 1.0,
    "patience": 3,
    "early_stop_metric": "f1_macro",
    "train_val_split": 0.9,
    "use_class_weights": true,
    "class_weights_mode": "manual",
    "class_weights": [
      2.2,
      0.4484,
      1.9
    ],
    "use_focal_loss": false,
    "focal_loss_alpha": [
      0.25,
      0.25,
      0.25
    ],
    "focal_loss_gamma": 2.0,
    "use_balanced_sampler": false,
    "balanced_sampler_mode": "effective_num",
    "balanced_sampler_beta": 0.999,
    "label_smoothing": 0.0
  },
  "data": {
    "processed_data_path": "data/processed/processed_data_subject_norm.pkl"
  }
}